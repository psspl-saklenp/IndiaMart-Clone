# ========================================================================
# Root .env.example
# ------------------------------------------------------------------------
# These vars are consumed by docker-compose.yml only. Each workspace
# (frontend, backend) has its own .env.example for app-level config.
# Copy to .env: cp .env.example .env
# ========================================================================

# ---------- Postgres ----------
DB_USER=postgres
DB_PASS=postgres
DB_PORT=5432
DB_NAME_DEVELOPMENT=indiamart_clone_dev
DB_NAME_TEST=indiamart_clone_test

# ---------- pgAdmin ----------
PGADMIN_EMAIL=admin@indiamart.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
