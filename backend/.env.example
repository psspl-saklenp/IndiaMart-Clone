# ========================================================================
# Backend .env.example
# Copy to backend/.env and fill in real values for local dev.
# Do NOT commit .env.
# ========================================================================

# ---------- Application ----------
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:3000
API_PREFIX=api/v1

# ---------- Database (PostgreSQL) ----------
# Defaults match docker-compose.yml so `npm run db:up` then `npm run dev:backend` works out of the box.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME_DEVELOPMENT=indiamart_clone_dev
DB_NAME_TEST=indiamart_clone_test
DB_NAME_PRODUCTION=
DB_DIALECT=postgres
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
# Set to "true" to log every SQL query (dev only)
DB_LOGGING=false

# ---------- JWT (used in Phase 2+; placeholder allowed in Phase 1) ----------
JWT_SECRET=replace-me-with-a-strong-random-string-min-32-chars
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-strong-random-string-min-32-chars
JWT_REFRESH_EXPIRATION=7d

# ---------- AWS (placeholders for Phase 3+) ----------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_BUCKET_PUBLIC_URL=

# ---------- Throttling ----------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ---------- Swagger ----------
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
