# ========================================================================
# Frontend .env.example
# Copy to frontend/.env.local for local dev. Do NOT commit real secrets.
# Vars prefixed NEXT_PUBLIC_ are exposed to the browser bundle.
# ========================================================================

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Public site URL (used for canonical / OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Environment label
NEXT_PUBLIC_ENV=development
